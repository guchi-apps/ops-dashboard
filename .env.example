# Supabase Auth（複数アプリ共通のプロジェクトを使用。db-console と同一プロジェクトの値を再利用する。
# Google Provider の設定はSupabaseダッシュボード側で行う。Publishable keyはフロントに公開してよい値）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ログイン許可メールアドレス（カンマ区切り、複数可）
ALLOWED_EMAILS=

# UptimeRobot（Read-Only APIキー）
UPTIMEROBOT_READ_ONLY_KEY=

# Uptime Kuma（公開ステータスページ経由でのモニター取得）
UPTIMEKUMA_BASE_URL=
UPTIMEKUMA_DASHBOARD_SLUG=

# ホスト（VPS・サブPC）のステータス表示。各ホストのエージェント（scripts/host-stats/）と
# 共有する固定トークン。32文字以上のランダム文字列を設定する
# （未設定なら受信は常に401になり、一度も受信していなければセクションも表示されない）
HOST_STATS_TOKEN=
# 画面に並べる順番（ホスト識別子をカンマ区切り）。ここに無いホストは後ろへ回り、識別子順に並ぶ
HOST_STATS_ORDER=
# 最終受信からこの秒数を過ぎたらオフライン扱いにする（未設定時は300）
HOST_STATS_OFFLINE_AFTER_SECONDS=
# グラフに残す履歴の長さ（時間、未設定時は24）
HOST_STATS_HISTORY_HOURS=
# 受信データの保存先（未設定時は ./.data/host-stats。この下にホスト識別子ごとのディレクトリを作る）
HOST_STATS_DATA_DIR=

# 定期ジョブ（systemd timer）の異常判定（#75）。監視するユニットはホスト側の
# HOST_STATS_TIMERS で指定する
# 次回予定からこの秒数を過ぎても実行されていなければ「未実行」とみなす（未設定時は3600）
HOST_STATS_TIMER_GRACE_SECONDS=
# 何回続けて失敗したら通知するか（未設定時は1＝1回目から通知する）。
# 数えるのは受信回数ではなく実行回数
HOST_STATS_TIMER_FAILURE_THRESHOLD=

# Signalyへのログイン通知（未設定なら通知しない）
SIGNALY_LOGIN_WEBHOOK_URL=
# Signalyへの異常通知（定期ジョブの失敗・復旧。未設定なら通知しない）。
# 日常的に流れるログイン通知に埋もれないよう、チャンネルを分ける
SIGNALY_ALERT_WEBHOOK_URL=

# AIトークン使用状況（Claude / ChatGPT）
# Claude: ~/.claude/.credentials.json の claudeAiOauth.refreshToken
# （`claude setup-token` の長期トークンは user:profile スコープが付かず使えない）
ANTHROPIC_OAUTH_REFRESH_TOKEN=
# ChatGPT: ~/.codex/auth.json の tokens.refresh_token / tokens.account_id
OPENAI_CHATGPT_REFRESH_TOKEN=
OPENAI_CHATGPT_ACCOUNT_ID=

# 課金プランの表示名（任意）。通常は各APIから自動取得するため未設定でよく、
# 設定した場合だけ表示名の上書きとして使われる
CLAUDE_PLAN_NAME=
CHATGPT_PLAN_NAME=

# GitHubの制限表示（未設定なら GitHub セクションを表示しない）
# 課金レポートのエンドポイントは fine-grained PAT に非対応のため、classic PAT を使う。
# 必要なスコープは repo（private リポジトリの一覧取得用）と read:org
GH_USAGE_TOKEN=
# 集計対象の Organization 名
GH_USAGE_ORG=

# Actions無料枠の上限（分/月、任意）。未設定時は Free プランの 2000
GH_ACTIONS_MINUTES_LIMIT=
# GitHub使用状況のキャッシュ秒数（未設定時は300）
GH_USAGE_CACHE_SECONDS=

# 使用状況のキャッシュ秒数（未設定時は300）と、更新したOAuthトークンの保存先（未設定時は ./.data/ai-usage-tokens.json）
AI_USAGE_CACHE_SECONDS=
AI_USAGE_STATE_PATH=

# 1Passwordのレート制限の表示（未設定なら 1Password セクションを表示しない）。
# 取得には 1Password CLI（op）がサーバーに入っている必要がある
OP_SERVICE_ACCOUNT_TOKEN=
# op の実行パス（任意）。PATH に無い場所へ入れた場合だけ設定する
OP_CLI_PATH=
# 1Password使用状況のキャッシュ秒数（未設定時は300）
OP_USAGE_CACHE_SECONDS=

# iPhoneウィジェット（Scriptable）から /api/claude-usage を叩くための固定トークン。
# 32文字以上のランダム文字列を設定する（未設定なら常に401を返す）
WIDGET_TOKEN=

# 同一VPS上のAIDE（MCPサーバー）から読み取りAPIを参照するための固定トークン。
# 32文字以上のランダム文字列を設定する
# （未設定ならトークン経路は無効になり、読み取りAPIはログインセッション必須のままになる）
OPS_API_TOKEN=
