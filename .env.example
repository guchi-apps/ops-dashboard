# Supabase Auth（複数アプリ共通のプロジェクトを使用。db-console と同一プロジェクトの値を再利用する。
# Google Provider の設定はSupabaseダッシュボード側で行う。Publishable keyはフロントに公開してよい値）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ログイン許可メールアドレス（カンマ区切り、複数可）
ALLOWED_EMAILS=

# UptimeRobot（Read-Only APIキー）
UPTIMEROBOT_READ_ONLY_KEY=

# Uptime Kuma（公開ステータスページ経由でのモニター取得）
UPTIMEKUMA_BASE_URL=
UPTIMEKUMA_DASHBOARD_SLUG=

# VPSディスク使用率の監視対象パス（未設定時は "/"）
SYSTEM_STATS_DISK_PATH=

# Signalyへのログイン通知（未設定なら通知しない）
SIGNALY_LOGIN_WEBHOOK_URL=

# AIトークン使用状況（Claude / ChatGPT）
# Claude: ~/.claude/.credentials.json の claudeAiOauth.refreshToken
# （`claude setup-token` の長期トークンは user:profile スコープが付かず使えない）
ANTHROPIC_OAUTH_REFRESH_TOKEN=
# ChatGPT: ~/.codex/auth.json の tokens.refresh_token / tokens.account_id
OPENAI_CHATGPT_REFRESH_TOKEN=
OPENAI_CHATGPT_ACCOUNT_ID=

# 課金プランの表示名（APIから取得できないため手動設定。ChatGPTはAPIの値を優先する）
CLAUDE_PLAN_NAME=
CHATGPT_PLAN_NAME=

# 使用状況のキャッシュ秒数（未設定時は300）と、更新したOAuthトークンの保存先（未設定時は ./.data/ai-usage-tokens.json）
AI_USAGE_CACHE_SECONDS=
AI_USAGE_STATE_PATH=
