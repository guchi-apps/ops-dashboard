# Mac mini（macOS）用のエージェント設定。
# /etc/ops-dashboard-host-stats.env として配置し、chmod 600 / root 所有にする。
# 読み込むのは agent-macos.sh（agent.sh ではない）。launchd から使う手順は README を参照。

OPS_DASHBOARD_URL=https://admin.gucchii.com

# ダッシュボード側の HOST_STATS_TOKEN と同じ値（1Password の apps/ops-dashboard/host-stats-token）
HOST_STATS_TOKEN=

HOST_STATS_ID=macmini
# launchd から bash で source されるため、空白を含む値は必ず引用符で囲む
# （囲まないと「HOST_STATS_LABEL=Mac を付けて mini を実行する」と解釈され、ラベルが設定されない）
HOST_STATS_LABEL="Mac mini"

# df -h を見て、監視したいマウントポイントに合わせる
HOST_STATS_DISK_PATHS=/

HOST_STATS_TIMEOUT=
