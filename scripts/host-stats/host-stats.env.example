# 各ホスト（VPS・サブPC）の送信エージェント（agent.sh）の設定。
# /etc/ops-dashboard-host-stats.env として配置し、chmod 600 / root 所有にする。

# ダッシュボードのURL（末尾のスラッシュは不要）。
# サブPCからは https://admin.gucchii.com、ダッシュボード自身が動くVPS上では http://localhost:3110
OPS_DASHBOARD_URL=https://admin.gucchii.com

# ダッシュボード側の HOST_STATS_TOKEN と同じ値（32文字以上のランダム文字列）
HOST_STATS_TOKEN=

# ホストの識別子。保存先ディレクトリ名になる（英小文字・数字・-・_）。VPS側は vps にする
HOST_STATS_ID=subpc

# 画面の見出しに使う表示名
HOST_STATS_LABEL=サブPC

# 監視するマウントポイント（カンマ区切り、未設定なら /）
HOST_STATS_DISK_PATHS=/

# 死活を見る systemd サービス（カンマ区切り、未設定なら監視しない）
HOST_STATS_SERVICES=

# 送信のタイムアウト秒（未設定なら15）
HOST_STATS_TIMEOUT=
